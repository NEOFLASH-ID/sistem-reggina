# lingkungan Python — khusus tiap mesin, jangan pernah ikut
.venv/
__pycache__/
*.pyc
.DS_Store

# dataset mentah & hasil praproses: besar, dan lisensinya milik penyedia AffectNet.
# Client tidak butuh ini untuk menjalankan sistem, hanya untuk melatih ulang.
data/raw/
data/processed/
kecerdasan buatan/

# database kerja berisi log pemakaian tiap mesin — jangan dilacak supaya
# `git pull` tidak bentrok. Yang dikirim hanya database bawaan (seed), yang
# disalin otomatis saat aplikasi pertama dijalankan.
data/db/*
!data/db/seed.sqlite3

# model terlatih & data uji IKUT dikirim (lihat pengecualian di bawah),
# supaya client cukup clone lalu jalan tanpa training 21 menit

# berkas kerja internal (penyusunan skripsi & uji coba), bukan untuk pengguna akhir
CLAUDE.md
laporan_bab5.md
buat_laporan.py
demo_kamera.py
demo_realtime.py
